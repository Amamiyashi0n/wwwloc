#!name=Apple WLOC 定位修改 (Cloudflare)
#!desc=Apple 网络定位修改 | 脚本与选点页面均由同一 Cloudflare Worker 提供: https://wwwloc-page.amamiyashion.workers.dev
#!author=Yu9191 Rewrite (Cloudflare bundle)
#!homepage=https://wwwloc-page.amamiyashion.workers.dev/
#!category=Tools

[Script]
Apple WLOC = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc,requires-body=1,binary-body-mode=1,max-size=0,timeout=30,script-path=https://wwwloc-page.amamiyashion.workers.dev/wloc.js,argument=longitude=113.94114&latitude=22.544577&accuracy=25&randomRadius=0&logLevel=info
WLOC Settings = type=http-request,pattern=^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save,requires-body=0,max-size=0,timeout=10,script-path=https://wwwloc-page.amamiyashion.workers.dev/wloc-settings.js

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
